# Correo público de recepción PQRS (no es secreto; sale en el HTML).
# Configúralo también como Variable de Actions: VITE_CONTACT_EMAIL
VITE_CONTACT_EMAIL=contacto@kodexis.co

# Base del sitio. Con dominio custom debe ser "/".
# Variable de Actions: VITE_BASE_PATH
VITE_BASE_PATH=/

# NUNCA subas claves reales al repo.
# Si usas Web3Forms, guárdala SOLO como Secret de Actions:
#   Settings → Secrets and variables → Actions → VITE_WEB3FORMS_ACCESS_KEY
# Nota: las variables VITE_* se incrustan en el JS del navegador.
# Usa solo keys públicas de formularios (con dominio restringido en el proveedor).
# VITE_WEB3FORMS_ACCESS_KEY=
